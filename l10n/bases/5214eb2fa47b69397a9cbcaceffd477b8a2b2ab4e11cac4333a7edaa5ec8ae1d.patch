+<!doctype html>
+<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Torrenter · Tlachihuani</title><link rel="stylesheet" href="workspace.css"><script src="layout.js" defer></script><script src="workspace.js" defer></script></head><body>
+<header>
+  <div class="mark" aria-hidden="true">XT</div>
+  <div class="workspace-title">
+    <div class="product-name">Torrenter</div>
+    <div class="account-heading" hidden>
+      <span id="owner-label">Signed-in user</span>
+      <h1 id="workspace-owner" dir="auto"></h1>
+    </div>
+  </div>
+  <span id="connection" role="status">Connecting…</span>
+</header>
+<main id="workspace" hidden><nav aria-label="Transfer actions"><button id="add">＋ Add torrent</button><button data-action="pause">Pause</button><button data-action="resume">Resume</button><button data-action="stop">Stop</button><button data-action="start">Start</button><button data-action="cancel">Cancel</button><button data-action="recheck">Recheck</button><button id="move">Move…</button><button data-action="reseed">Reseed</button><button id="prefs">Preferences</button><button id="remove">Remove record</button><button id="erase">Erase files…</button></nav>
+<div class="layout"><aside><h2>Queue</h2><label>Search <input id="search" type="search" placeholder="Torrent name"></label><label>Status <select id="filter"><option value="">All states</option></select></label><label>Category <select id="category"></select></label><label>Tag <select id="tag"></select></label><label>Tracker host <select id="tracker"></select></label><label>Activity <select id="activity"><option value="">All activity</option><option value="active">Transferring</option><option value="idle">Idle</option><option value="running">Desired running</option></select></label><p id="count"></p><p id="pending-metadata" role="status" hidden></p></aside>
+<div class="work"><div class="table" id="transfer-grid"><table><thead><tr><th>Select</th><th><button data-sort="name">Name</button></th><th><button data-sort="selected_bytes">Size</button></th><th>Progress</th><th><button data-sort="phase">Status</button></th><th>Seeds / peers</th><th>↓ Speed</th><th>↑ Speed</th><th>ETA</th><th>Ratio</th><th>Availability</th><th><button data-sort="queue_position">Queue</button></th><th>Completed</th></tr></thead><tbody id="rows"></tbody></table></div>
+<section class="inspect"><h2 id="selected">Transfer details</h2><div class="tabs" aria-label="Detail views"><button data-tab="general">General</button><button data-tab="trackers">Trackers</button><button data-tab="peers">Peers</button><button data-tab="web-seeds">HTTP sources</button><button data-tab="files">Content</button><button data-tab="manifest">Verified output</button></div><div id="details">Select a transfer.</div></section></div></div></main>
