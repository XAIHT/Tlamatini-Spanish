+@login_required
+@never_cache
+@csrf_protect
+@sensitive_post_parameters("magnet", "endpoints")
+@require_http_methods(["GET", "POST"])
+def sources(request):
+    context = {}
+    status = 200
+    if request.method == "POST":
+        try:
+            profile = profile_for(request.user.pk)
+            if request.POST.get("source_kind") in ("trackers", "web_seeds"):
+                kind = request.POST["source_kind"]
+                context["source_ref"] = stage(
+                    profile, kind, request.POST.get("endpoints", "")
+                )
+                context["source_action"] = "set_" + kind
+                return render(request, "agent/torrenter_sources.html", context)
+            upload = request.FILES.get("torrent")
+            magnet = request.POST.get("magnet", "").strip()
+            if bool(upload) == bool(magnet):
+                raise TorrentError("Choose a .torrent file or enter one magnet link.")
+            if upload:
+                if not 0 < upload.size <= 1024 * 1024:
+                    raise TorrentError("The torrent metadata must be 1 byte to 1 MiB.")
+                body = {"metainfo": base64.b64encode(upload.read()).decode("ascii")}
+            else:
+                if len(magnet) > 8192 or not magnet.lower().startswith("magnet:?"):
+                    raise TorrentError(
+                        "Enter a valid magnet link of up to 8192 characters."
+                    )
+                body = {"magnet": magnet}
+            _, context["inspection"] = client.request(
+                "POST", "inspections", body, bearer=client.session(profile)
+            )
+        except TorrentError as exc:
+            context["error"] = str(exc)
+            status = 400
+    return render(request, "agent/torrenter_sources.html", context, status=status)
diff --git a/despues/Tlamatini/agent/torrenter_workspace/layout.js b/despues/Tlamatini/agent/torrenter_workspace/layout.js
new file mode 100644
index 0000000..c11a7b4
--- /dev/null
+++ b/despues/Tlamatini/agent/torrenter_workspace/layout.js
@@ -0,0 +1,59 @@
+'use strict';
+const DeskLayout = (() => {
+  const byId = id => document.getElementById(id);
+  const header = document.querySelector('thead tr');
+  const cells = Array.from(header.cells);
+  const identity = cells.map((_, i) => i);
+  const picker = byId('column');
+  cells.forEach((cell, i) => picker.add(new Option(cell.textContent, i)));
+  let key = '', order = [...identity], widths = {}, height = 40, sort = 'name', direction = 1;
+
+  function save() {
+    if (key) try { localStorage.setItem(key, JSON.stringify({order,widths,height,sort,direction})); } catch {}
+  }
+  function bounded(value, min, max, fallback) {
+    return Number.isFinite(value) && value >= min && value <= max ? value : fallback;
+  }
+  function arrange() {
+    for (const id of order) {
+      const cell = cells[id];
+      cell.style.minWidth = bounded(widths[id],60,500,88) + 'px';
+      header.append(cell);
+    }
+    byId('grid-height').value = height;
+    byId('transfer-grid').style.height = height + 'vh';
+    byId('column-width').value = bounded(widths[picker.value],60,500,88);
+    for (const row of byId('rows').rows) {
+      const columns = Array.from(row.cells);
+      if (columns.length !== order.length) continue;
+      // Cell identity survives preference edits until the next queue snapshot.
+      for (const [index,cell] of columns.entries()) if (!cell.dataset.column) cell.dataset.column = String(index);
+      for (const id of order) row.append(columns.find(cell => cell.dataset.column === String(id)));
+    }
+  }
+  function shift(by) {
+    const index = order.indexOf(Number(picker.value)), to = index + by;
+    if (to < 0 || to >= order.length) return;
+    [order[index],order[to]] = [order[to],order[index]];
+    arrange(); save();
+  }
+  byId('col-left').onclick = () => shift(-1);
+  byId('col-right').onclick = () => shift(1);
+  picker.onchange = arrange;
+  byId('column-width').oninput = e => { widths[picker.value] = Number(e.target.value); arrange(); save(); };
+  byId('grid-height').oninput = e => { height = Number(e.target.value); arrange(); save(); };
+  return {
+    load(profile) {
+      key='xt.torrenter.layout.'+profile;
+      let data={}; try { data=JSON.parse(localStorage.getItem(key)) || {}; } catch {}
+      order = Array.isArray(data.order) && data.order.length===identity.length && identity.every(i=>data.order.includes(i)) ? data.order : [...identity];
+      widths = data.widths && typeof data.widths === 'object' ? data.widths : {};
+      height = bounded(data.height,20,72,40);
+      sort = [...document.querySelectorAll('[data-sort]')].some(b=>b.dataset.sort===data.sort) ? data.sort : 'name';
+      direction = data.direction===-1 ? -1 : 1;
+      arrange();return {sort,direction};
+    },
+    sortBy(field,sign) { sort=field;direction=sign;save(); },
+    arrange
+  };
+})();
