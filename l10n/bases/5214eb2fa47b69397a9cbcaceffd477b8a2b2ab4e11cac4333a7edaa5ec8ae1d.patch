+@never_cache
+@login_required
+@require_http_methods(["GET"])
+def workspace(request):
+    return _asset("workspace.html")
+
+
+@never_cache
+@login_required
+@require_http_methods(["GET"])
+def workspace_asset(request, asset):
+    return _asset(asset)
