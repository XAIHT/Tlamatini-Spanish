etween}dialog{color:inherit;width:min(95vw,36rem);max-height:85vh}dialog::backdrop{background:#061317b8}.choice{display:flex;align-items:center;gap:.5rem}.listing{max-height:13rem;overflow:auto}.error{color:#ffb69f}@media(max-width:720px){.layout{display:block}aside{display:flex;gap:.5rem;flex-wrap:wrap;align-items:center;border:0}aside label{max-width:11rem}.table{min-height:0}}
